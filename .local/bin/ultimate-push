#!/bin/bash
#
# Author: [github.com/ysxninja](https://github.com/ysxninja)
# Description: This Bash script pushes updates & updates local backups
# Use case: Add to crontab to monitor/update scripts/repositories
# License: MIT
# Dependencies: httping, git, rsync
# Updated and modularized for clarity and maintainability
# TODO: check if wayland or wayland-dual branch before dotgit push

# Colors for terminal output
CYAN="\e[1;36m"
GREEN="\e[1;32m"
RED="\e[1;31m"
YELLOW="\e[1;33m"
RESET="\e[0m"

function print_info() {
    printf "\n$CYAN$1$RESET\n"
}

function check_connection() {
    CYAN="\e[1;36m"
    GREEN="\e[1;32m"
    RED="\e[1;31m"
    RESET="\e[0m"

    echo -ne "\n${CYAN}Checking internet connection${RESET}"

    # Start loading animation in the background
    while :; do
        for s in '.' '..' '...'; do
            echo -ne "\r${CYAN}Checking internet connection${s}${RESET}   "
            sleep 0.5
        done
    done &

    # Save PID of background process
    LOADING_PID=$!

    # Run the actual connection check
    if httping -qc 1 -t 2 google.com > /dev/null 2>&1; then
        CONNECTION_STATUS="connected"
    else
        CONNECTION_STATUS="disconnected"
    fi

    # Kill loading animation
    kill "$LOADING_PID" > /dev/null 2>&1
    wait "$LOADING_PID" 2>/dev/null

    # Print final connection status
    if [ "$CONNECTION_STATUS" == "connected" ]; then
        echo -e "\r${GREEN}Connection status: Connected${RESET}       "
    else
        echo -e "\r${RED}Connection status: Disconnected${RESET}   "
        echo -e "${RED}No internet connection detected. Exiting.${RESET}"
        exit 4
    fi
}

function push_to_git() {
    local repo_path=$1
    local repo_name=$2
    print_info " Pushing $repo_name to repo"
    git -C "$repo_path" push -u origin main || printf "\n\t${RED}Push to $repo_name failed!$RESET\n"
}

function commit_and_push_dotfiles() {
    local git_dir="/home/$USER/dotfiles/"
    local work_tree="/home/$USER"
    print_info " Pushing dotfiles to repo"
    /usr/bin/git --git-dir="$git_dir" --work-tree="$work_tree" commit -a -m "Automated dotfiles update"
    /usr/bin/git --git-dir="$git_dir" --work-tree="$work_tree" fetch origin
    /usr/bin/git --git-dir="$git_dir" --work-tree="$work_tree" push origin wayland || printf "\n\t${RED}Dotfiles push failed!$RESET\n"
}

function backup_files() {
    local src=$1
    local dest=$2
    local description=$3
    rsync -av "$src" "$dest" && printf "\n${GREEN}${description} backup successful$RESET\n" || printf "\n${RED}${description} backup failed$RESET\n"
}

# Main script execution
check_connection

push_to_git "/home/$USER/.task/" "tasks"
push_to_git "/home/$USER/.password-store/" "random keys store"
commit_and_push_dotfiles

print_info "Backing up local files"
backup_files ~/.zsh_history ~/ysbackup/history "History"
backup_files ~/.gitconfig ~/ysbackup/.gitconfig "Git user config"

printf "\n${YELLOW}✅✅✅ Completed!$RESET\n\n\n"
